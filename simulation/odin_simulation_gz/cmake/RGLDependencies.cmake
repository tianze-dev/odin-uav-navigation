set(ODIN_RGL_CACHE "${CMAKE_CURRENT_SOURCE_DIR}/.deps/rgl" CACHE PATH "Verified RGL cache")
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/dependencies/lock.json" lock)
function(verify relative sha)
  set(path "${ODIN_RGL_CACHE}/${relative}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Missing ${path}; run scripts/fetch_dependencies.py")
  endif()
  file(SHA256 "${path}" actual)
  if(NOT actual STREQUAL sha)
    message(FATAL_ERROR "Checksum mismatch: ${path}")
  endif()
endfunction()
string(JSON header_hash GET "${lock}" artifacts 1 sha256)
verify("include/rgl/api/core.h" "${header_hash}")
string(JSON lib_hash GET "${lock}" library sha256)
verify("lib/libRobotecGPULidar.so" "${lib_hash}")
add_library(RobotecGPULidar SHARED IMPORTED GLOBAL)
set_target_properties(RobotecGPULidar PROPERTIES IMPORTED_LOCATION "${ODIN_RGL_CACHE}/lib/libRobotecGPULidar.so" INTERFACE_INCLUDE_DIRECTORIES "${ODIN_RGL_CACHE}/include")
