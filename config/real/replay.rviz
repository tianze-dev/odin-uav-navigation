# Read-only bag visualization. No navigation panel or goal-publishing tool.
Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Time
  Name: Time
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 40
    Reference Frame: odom
  - Class: rviz_default_plugins/PointCloud2
    Name: Odin scan (odom)
    Enabled: true
    Topic:
      Value: /navigation/cloud
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Decay Time: 0.6
    Style: Points
    Size (Pixels): 3
    Color Transformer: AxisColor
    Axis: Z
  - Class: rviz_default_plugins/PointCloud2
    Name: Occupied voxels (cyan, solid)
    Enabled: true
    Topic:
      Value: /grid_map/occupancy
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Boxes
    Size (m): 0.1
    Color Transformer: FlatColor
    Color: 80; 220; 240
    Alpha: 1
  - Class: rviz_default_plugins/Marker
    Name: Local map window
    Enabled: true
    Topic:
      Value: /grid_map/bounds
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Marker
    Name: Global reference
    Enabled: false
    Topic:
      Value: /planning/global_list
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Marker
    Name: A star search
    Enabled: true
    Topic:
      Value: /planning/a_star_list
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Marker
    Name: Initial trajectory
    Enabled: true
    Topic:
      Value: /planning/init_list
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Marker
    Name: Optimized candidate
    Enabled: true
    Topic:
      Value: /planning/optimal_list
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Marker
    Name: Accepted trajectory
    Enabled: true
    Topic:
      Value: /planning/accepted
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 2
  - Class: rviz_default_plugins/Marker
    Name: Active goal
    Enabled: true
    Topic:
      Value: /planning/goal_point
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Marker
    Name: Failed candidate
    Enabled: false
    Topic:
      Value: /planning/failed_list
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 20
  - Class: rviz_default_plugins/Path
    Name: Actual flight path
    Enabled: true
    Topic:
      Value: /navigation/flight_path
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Line Style: Billboards
    Line Width: 0.02
    Color: 70; 220; 90
    Alpha: 1
    Buffer Length: 1
    Pose Style: None
  - Class: rviz_default_plugins/PointCloud2
    Name: Inflated obstacles
    Enabled: true
    Topic:
      Value: /grid_map/occupancy_inflate
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Boxes
    Size (m): 0.1
    Color Transformer: FlatColor
    Color: 255; 150; 40
    Alpha: 0.2
  - Class: rviz_default_plugins/MarkerArray
    Name: Navigation visuals
    Enabled: true
    Topic:
      Value: /navigation/state_markers
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 5
  - Class: rviz_default_plugins/Odometry
    Name: Body odometry
    Enabled: true
    Topic:
      Value: /navigation/odometry
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Keep: 1
    Shape: Axes
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 17.0
      Focal Point:
        X: 6.0
        Y: 0.5
        Z: 1.2
      Pitch: 0.65
      Yaw: 0.8
      Target Frame: odom
Window Geometry:
  Width: 1280
  Height: 800
